# Copy this file to .env and adjust values.
# NEVER commit your real .env file.
#
# Every integration below is optional -- this system starts and runs with
# none of them configured, it just won't do much until you add at least
# one. See README.md for the recommended order to add them in.

# --- Universe ---
# Comma-separated tickers. Empty uses the built-in starter watchlist
# (semiconductor equipment, defense tier-2, grid/data-center, battery/
# storage ecosystems -- see src/smartboi/universe.py).
SYMBOLS=

# --- SEC EDGAR ingestion (8-K material events, 10-K customer/supplier
# disclosures, Form 4 insider transactions) ---
ENABLE_EDGAR_INGESTION=true
# SEC requires a descriptive User-Agent with real contact info on every
# request or it will block/rate-limit you. Not a secret, just informational.
EDGAR_USER_AGENT=
EDGAR_FORMS=8-K,10-K,4
EDGAR_POLL_INTERVAL_SEC=3600
# Rolling lookback window checked on every poll -- dedup prevents
# reprocessing a filing already seen.
EDGAR_LOOKBACK_DAYS=14

# --- News ingestion (Finnhub company-news, free tier) ---
ENABLE_NEWS_INGESTION=true
FINNHUB_API_KEY=
NEWS_POLL_INTERVAL_SEC=900
NEWS_LOOKBACK_DAYS=3

# --- Claude: relationship extraction, dossier updates, skeptic pass ---
# Without this, evidence is still collected but never scored into dossiers.
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-haiku-4-5-20251001
DOSSIER_MODEL=claude-haiku-4-5-20251001
SKEPTIC_MODEL=claude-haiku-4-5-20251001

# --- Evidence / signal thresholds ---
# A dossier signals once confidence * magnitude clears this bar AND has at
# least MIN_INDEPENDENT_SOURCES distinct-domain corroborating items.
SIGNAL_CONFIDENCE_THRESHOLD=0.65
MIN_INDEPENDENT_SOURCES=2
MAX_HORIZON_DAYS=56

# --- Paper trade journal (percentage-based stop/target -- no intraday bar
# data exists at a weeks-long holding horizon) ---
STOP_LOSS_PCT=8.0
TAKE_PROFIT_PCT=16.0

# --- Read-only IB price feed. NEVER places orders -- see prices.py, which
# contains no order-placement code at all. Off by default; until enabled,
# dossiers/signals still accumulate and log fully, they just can't be
# marked to market or opened as a hypothetical position yet. ---
ENABLE_IB_PRICE_FEED=false
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=27
PRICE_POLL_INTERVAL_SEC=21600

# --- Universe auto-screen: monthly market-cap/analyst-coverage recheck
# that prunes tickers that no longer fit. Requires FINNHUB_API_KEY. ---
ENABLE_UNIVERSE_AUTOSCREEN=true
UNIVERSE_SCREEN_INTERVAL_DAYS=30
UNIVERSE_MIN_MARKET_CAP_MUSD=100.0
UNIVERSE_MAX_MARKET_CAP_MUSD=5000.0
UNIVERSE_MAX_ANALYST_COUNT=6

LOG_LEVEL=INFO
LOG_DIR=logs

# Optional: a JSON payload is POSTed here on every signal and paper trade
# open/close -- point it at a Home Assistant webhook trigger
# (http://homeassistant.local:8123/api/webhook/<your-id>) or any HTTP
# endpoint. Empty disables alerts.
ALERT_WEBHOOK_URL=

# --- Dashboard ---
ENABLE_DASHBOARD=true
DASHBOARD_PORT=8100
