# Copy this file to .env and adjust values.
# NEVER commit your real .env file.
#
# Every integration below is optional -- this system starts and runs with
# none of them configured, it just won't do much until you add at least
# one. See README.md for the recommended order to add them in.

# --- Universe ---
# SYMBOLS: comma-separated TRADEABLE tickers (your small/mid-caps).
# ANCHOR_SYMBOLS: comma-separated ANCHOR tickers -- big, heavily-covered
# giants (e.g. AAPL,MSFT,TSM) whose news should propagate to the tradeable
# names; never trade targets themselves. Setting EITHER replaces the
# built-in starter watchlist entirely with your two lists; both empty uses
# the starter watchlist (see src/smartboi/universe.py). Relationships
# between your symbols are discovered automatically from the tradeable
# companies' 10-K filings (see ENABLE_RELATIONSHIP_BACKFILL below).
SYMBOLS=
ANCHOR_SYMBOLS=

# --- SEC EDGAR ingestion (8-K material events, 10-K/10-Q customer/supplier
# disclosures, Form 4 insider transactions) ---
ENABLE_EDGAR_INGESTION=true
# One-time extraction from each tradeable company's most recent 10-K
# (regardless of age) so the relationship graph populates on first run
# instead of over a year of annual filings. Once per symbol, ever. Ongoing
# 10-Qs (quarterly) then keep the graph refreshed between annual 10-Ks.
ENABLE_RELATIONSHIP_BACKFILL=true
# SEC requires a descriptive User-Agent with real contact info on every
# request or it will block/rate-limit you. Not a secret, just informational.
EDGAR_USER_AGENT=
EDGAR_FORMS=8-K,10-K,10-Q,4
EDGAR_POLL_INTERVAL_SEC=3600
# Rolling lookback window checked on every poll -- dedup prevents
# reprocessing a filing already seen.
EDGAR_LOOKBACK_DAYS=14

# --- News ingestion (Finnhub company-news, free tier) ---
ENABLE_NEWS_INGESTION=true
FINNHUB_API_KEY=
# 1h is plenty -- this strategy holds positions for weeks (MAX_HORIZON_DAYS),
# so 15-minute freshness just multiplies LLM call volume/cost for no benefit.
NEWS_POLL_INTERVAL_SEC=3600
NEWS_LOOKBACK_DAYS=3

# --- Claude: relationship extraction, dossier updates, skeptic pass ---
# Without this, evidence is still collected but never scored into dossiers.
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-haiku-4-5-20251001
DOSSIER_MODEL=claude-haiku-4-5-20251001
SKEPTIC_MODEL=claude-haiku-4-5-20251001

# --- Cost controls (see the dashboard for actual calls/tokens used today) ---
# Hard daily ceiling on Claude API calls, combined across extraction/
# dossier-update/skeptic. Deferred evidence is retried once the budget
# resets at UTC midnight, never discarded.
MAX_DAILY_LLM_CALLS=3000
# Caps propagated-evidence fan-out: at most this many pieces of evidence
# about one linked (non-direct) origin get scored against one target
# within the cooldown window below -- prevents a noisy anchor from burning
# a call for every single article about it once the link keeps refusing.
MAX_PROPAGATED_EVIDENCE_PER_LINK=3
PROPAGATED_EVIDENCE_COOLDOWN_HOURS=6

# --- Evidence / signal thresholds ---
# A dossier signals once confidence * magnitude clears this bar AND has at
# least MIN_INDEPENDENT_SOURCES distinct-domain corroborating items.
SIGNAL_CONFIDENCE_THRESHOLD=0.65
MIN_INDEPENDENT_SOURCES=2
# Higher bar when a dossier's agreeing evidence is ENTIRELY news: reworded
# wire copy can slip past dedup as two "independent" publishers, and
# filings (primary disclosures) are immune to that failure mode.
MIN_INDEPENDENT_SOURCES_NEWS_ONLY=3
MAX_HORIZON_DAYS=56

# --- Entry timing ("have we missed the correction already"). Both require
# ENABLE_IB_PRICE_FEED=true -- without a price feed there's no price to
# check a signal's entry against, so these have no effect yet. ---
# Skip opening a signaled trade if price already moved this much (%) in the
# favorable direction since the signal fired -- likely already priced in.
MAX_FAVORABLE_DRIFT_PCT=5.0
# Expire a signal that sits unopened (drift-blocked, or IB unreachable) this
# many days, resetting it to ACTIVE instead of chasing an increasingly stale
# opportunity forever.
SIGNAL_ENTRY_DEADLINE_DAYS=5

# --- Paper trade journal (percentage-based stop/target -- no intraday bar
# data exists at a weeks-long holding horizon) ---
STOP_LOSS_PCT=8.0
TAKE_PROFIT_PCT=16.0

# --- Read-only IB price feed. NEVER places orders -- see prices.py, which
# contains no order-placement code at all. Off by default; until enabled,
# dossiers/signals still accumulate and log fully, they just can't be
# marked to market or opened as a hypothetical position yet. ---
ENABLE_IB_PRICE_FEED=false
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=27
PRICE_POLL_INTERVAL_SEC=21600

# --- Universe auto-screen: monthly market-cap/analyst-coverage recheck
# that prunes tickers that no longer fit. Requires FINNHUB_API_KEY. ---
ENABLE_UNIVERSE_AUTOSCREEN=true
UNIVERSE_SCREEN_INTERVAL_DAYS=30
UNIVERSE_MIN_MARKET_CAP_MUSD=100.0
UNIVERSE_MAX_MARKET_CAP_MUSD=5000.0
UNIVERSE_MAX_ANALYST_COUNT=6

# Tighter price-poll cadence used only while a SIGNALED dossier is waiting
# for an entry -- marking open trades and confirming an entry are different
# jobs, and at the idle 6h cadence a signal that fires mid-session is
# usually next looked at after the close.
SIGNAL_ENTRY_POLL_INTERVAL_SEC=900

LOG_LEVEL=INFO
LOG_DIR=logs

# Optional: a JSON payload is POSTed here on every signal and paper trade
# open/close -- point it at a Home Assistant webhook trigger
# (http://homeassistant.local:8123/api/webhook/<your-id>) or any HTTP
# endpoint. Empty disables alerts.
ALERT_WEBHOOK_URL=

# --- Dashboard ---
ENABLE_DASHBOARD=true
DASHBOARD_PORT=8100
